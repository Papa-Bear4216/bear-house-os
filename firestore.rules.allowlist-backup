rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAllowed() {
      return request.auth != null &&
        request.auth.token.email in [
          'michael711hebert@gmail.com',
          'littlebear8991@gmail.com',
          'jchebert2010@gmail.com',
          'hpfanatic009@gmail.com'
        ];
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'color', 'role', 'points'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.color is string && data.color.size() <= 50
        && data.role in ['superadmin', 'admin', 'child']
        && data.points is number
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000000))
        && (!('meetLink' in data) || (data.meetLink is string && data.meetLink.size() <= 500))
        && (!('isExempt' in data) || data.isExempt is bool);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'assigneeId', 'date', 'pointsValue'])
        && data.id is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.assigneeId is string
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.pointsValue is number && data.pointsValue >= 0 && data.pointsValue <= 1000
        && (!('completed' in data) || data.completed is bool)
        && (!('status' in data) || data.status in ['todo', 'pending', 'done']);
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['id', 'title', 'userId', 'date'])
        && data.id is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.userId is string
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 10))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 10));
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isAllowed() && isValidUser(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['points', 'avatarUrl', 'name', 'color', 'role', 'meetLink', 'isExempt']);
      allow delete: if false;
    }

    // --- Tasks ---
    match /tasks/{taskId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidId(taskId) && isValidTask(request.resource.data);
      allow update: if isAllowed() && isValidTask(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'assigneeId', 'date', 'completed', 'status', 'pointsValue']);
      allow delete: if isAllowed();
    }

    // --- Events ---
    match /events/{eventId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && isValidId(eventId) && isValidEvent(request.resource.data);
      allow update: if isAllowed() && isValidEvent(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'userId', 'date', 'startTime', 'endTime']);
      allow delete: if isAllowed();
    }

    // --- Meal Plans ---
    match /mealPlans/{docId} {
      allow read:   if isAllowed();
      allow create: if isAllowed();
      allow update: if isAllowed();
      allow delete: if isAllowed();
    }

    // --- Households (shopping, Hermes memory, Plaid, dashboard config)
    // Floor plan is stored at households/shared/config/floorplan ---
    match /households/{uid}/{document=**} {
      allow read:  if isAllowed();
      allow write: if isAllowed();
    }

    // --- Family Messages ---
    match /familyMessages/{familyCode}/messages/{messageId} {
      allow read:   if isAllowed();
      allow create: if isAllowed();
      allow delete: if isAllowed() && request.auth.uid == resource.data.userId;
    }

    // --- Posts (Bulletin Board) ---
    match /posts/{postId} {
      allow read:   if isAllowed();
      allow create: if isAllowed();
      allow update: if isAllowed();
      allow delete: if isAllowed();
    }

    // --- Gallery ---
    match /gallery/{photoId} {
      allow read:   if isAllowed();
      allow create: if isAllowed();
      allow delete: if isAllowed();
    }
  }
}
