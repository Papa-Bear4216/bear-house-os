rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Check if user is an admin - this is just a dummy helper for now. 
    // In a real app, this should look up a user record to check their role.
    // Given the issues, I will start with a simpler structure.
    
    // 0. Default Deny
    match /{document=**} { allow read, write: if false; }

    // --- Users ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // In a real app, limit this!
      allow create: if isSignedIn() && isValidId(userId);
      allow update: if isSignedIn() && userId == request.auth.uid;
    }

    // --- Tasks ---
    match /tasks/{taskId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(taskId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Events ---
    match /events/{eventId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(eventId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // --- Posts ---
    match /posts/{postId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(postId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}
