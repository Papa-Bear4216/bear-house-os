rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- Membership & tenancy ----
    // Family membership is established by your users/{uid} doc, which carries
    // your familyId. The email allowlist gates ONLY profile creation (joining);
    // all data access is familyId-scoped tenant isolation.

    function isAllowedEmail() {
      return request.auth.token.email in [
        'michael711hebert@gmail.com',
        'littlebear8991@gmail.com',
        'jchebert2010@gmail.com',
        'hpfanatic009@gmail.com'
      ];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function myFamilyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId;
    }

    function isFamilyMember() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myFamilyId() is string;
    }

    // Doc being read/updated/deleted belongs to my family
    function inMyFamily() {
      return isFamilyMember() && resource.data.familyId == myFamilyId();
    }

    // Doc being created is stamped with my family
    function createsInMyFamily() {
      return isFamilyMember() && request.resource.data.familyId == myFamilyId();
    }

    // Updates may never move a doc to another family (or drop the stamp)
    function keepsFamilyId() {
      return request.resource.data.familyId == resource.data.familyId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'color', 'role', 'points'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.color is string && data.color.size() <= 50
        && data.role in ['superadmin', 'admin', 'child']
        && data.points is number
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 1000000))
        && (!('meetLink' in data) || (data.meetLink is string && data.meetLink.size() <= 500))
        && (!('isExempt' in data) || data.isExempt is bool);
    }

    function isValidTask(data) {
      // 'id' deliberately not required — tasks use Firestore auto-IDs and the
      // app's create payload carries no id field.
      return data.keys().hasAll(['title', 'assigneeId', 'date', 'pointsValue'])
        && (!('id' in data) || data.id is string)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.assigneeId is string
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.pointsValue is number && data.pointsValue >= 0 && data.pointsValue <= 1000
        && (!('completed' in data) || data.completed is bool)
        && (!('status' in data) || data.status in ['todo', 'pending', 'done']);
    }

    function isValidEvent(data) {
      // 'id' deliberately not required — events use Firestore auto-IDs and the
      // app's create payload carries no id field.
      return data.keys().hasAll(['title', 'userId', 'date'])
        && (!('id' in data) || data.id is string)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.userId is string
        && data.date is string && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 10))
        && (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 10));
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || inMyFamily());
      allow create: if isSignedIn() && request.auth.uid == userId && isAllowedEmail()
        && isValidId(userId)
        && request.resource.data.familyId is string && request.resource.data.familyId.size() <= 32;
      allow update: if inMyFamily() && keepsFamilyId() && isValidUser(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['points', 'avatarUrl', 'name', 'color', 'role', 'meetLink', 'isExempt', 'familyCode', 'updatedAt']);
      allow delete: if false;

      // Per-device push tokens — only the owner reads/writes their own
      match /fcmTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Tasks ---
    match /tasks/{taskId} {
      allow read: if inMyFamily();
      allow create: if createsInMyFamily() && isValidId(taskId) && isValidTask(request.resource.data);
      allow update: if inMyFamily() && keepsFamilyId() && isValidTask(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'assigneeId', 'date', 'completed', 'status', 'pointsValue', 'properStorage', 'updatedAt']);
      allow delete: if inMyFamily();
    }

    // --- Events ---
    match /events/{eventId} {
      allow read: if inMyFamily();
      allow create: if createsInMyFamily() && isValidId(eventId) && isValidEvent(request.resource.data);
      allow update: if inMyFamily() && keepsFamilyId() && isValidEvent(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'userId', 'date', 'startTime', 'endTime', 'updatedAt']);
      allow delete: if inMyFamily();
    }

    // --- Meal Plans ---
    match /mealPlans/{docId} {
      allow read:   if inMyFamily();
      allow create: if createsInMyFamily();
      allow update: if inMyFamily() && keepsFamilyId();
      allow delete: if inMyFamily();
    }

    // --- Games ---
    match /games/{gameId} {
      allow read:   if inMyFamily();
      allow create: if createsInMyFamily();
      allow update: if inMyFamily() && keepsFamilyId();
      allow delete: if inMyFamily();
    }

    // --- Posts (Bulletin Board) ---
    match /posts/{postId} {
      allow read:   if inMyFamily();
      allow create: if createsInMyFamily();
      allow update: if inMyFamily() && keepsFamilyId();
      allow delete: if inMyFamily();
    }

    // --- Gallery ---
    match /gallery/{photoId} {
      allow read:   if inMyFamily();
      allow create: if createsInMyFamily();
      allow delete: if inMyFamily();
    }

    // --- Households (shopping, pantry, Hermes memory, Plaid, dashboard config,
    // floor plan at households/shared/config/floorplan) ---
    // Path-keyed by member uid or 'shared'; membership-scoped.
    match /households/{hid}/{document=**} {
      allow read, write: if isFamilyMember();
    }

    // --- Family Messages (family-scoped by path segment) ---
    match /familyMessages/{familyCode}/messages/{messageId} {
      allow read, create: if isFamilyMember() && familyCode == myFamilyId();
      allow delete: if isFamilyMember() && familyCode == myFamilyId()
        && request.auth.uid == resource.data.userId;
    }
  }
}
