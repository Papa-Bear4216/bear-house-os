# ANTHROPIC_API_KEY: Powers Hermes AI (Claude). Primary AI provider.
ANTHROPIC_API_KEY="sk-ant-..."

# GEMINI_API_KEY: Fallback AI when Claude is unavailable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Firebase (client-side config — get from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_ID=your-firestore-database-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Push Notifications (FCM)
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key-from-firebase-console"

# Plaid (Budget / Banking integration)
PLAID_ENV="sandbox"
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"
