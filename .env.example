# ANTHROPIC_API_KEY: Powers Hermes AI (Claude). Primary AI provider.
ANTHROPIC_API_KEY="sk-ant-..."

# GEMINI_API_KEY: Fallback AI when Claude is unavailable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Firebase Push Notifications (FCM)
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key-from-firebase-console"

# Plaid (Budget / Banking integration)
PLAID_ENV="sandbox"
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"
